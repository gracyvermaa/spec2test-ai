# Copy to frontend/.env.local for local overrides. Never commit real .env files.
# Variables must start with VITE_ to be exposed to the browser.

# Base URL of the FastAPI backend (no trailing slash).
# Local development (this is also the automatic fallback in `npm run dev`):
VITE_API_BASE_URL=http://localhost:8000
# Production: set this in Vercel (frontend project), e.g.
# VITE_API_BASE_URL=https://your-backend.vercel.app
