# Copy to backend/.env for local development. Never commit the real .env file.

# "mock" (default) = offline rule-based AI, zero API cost.
# "live" = calls Gemini and requires GEMINI_API_KEY. Keep "mock" for deployments.
AI_MODE=mock

# Comma-separated browser origins allowed by CORS (no trailing slash).
# Leave unset locally (defaults to http://localhost:5173 and :5174).
# Production example: ALLOWED_ORIGINS=https://your-frontend.vercel.app
# ALLOWED_ORIGINS=

# Optional: regex to also allow the frontend's Vercel preview URLs.
# ALLOWED_ORIGIN_REGEX=^https://your-frontend-.*\.vercel\.app$

# Only needed when AI_MODE=live:
# GEMINI_API_KEY=
